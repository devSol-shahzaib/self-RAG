# OpenAI — embeddings (text-embedding-3-small) and generation (gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Pinecone — vector store
PINECONE_API_KEY=pcsk_...
# Name of the Pinecone index (must be created with 1536 dimensions, cosine metric)
PINECONE_INDEX=ask-shahzaib

# Security
# Comma-separated allowlist of browser origins permitted to call the API.
# Defaults to the Vite dev server if unset.
CORS_ORIGIN=http://localhost:5173
# Port the API listens on (optional; defaults to 3001)
# PORT=3001
